// Grafana Alloy sidecar: SonarQube (logs + metrics) and the host node (metrics).

// SonarQube log files (sonar, web, ce, es, access), read from the shared logs volume.
local.file_match "sonarqube" {
  path_targets = [{"__path__" = "/sonarqube/logs/*.log", "service_name" = "sonarqube"}]
}

loki.source.file "sonarqube" {
  targets    = local.file_match.sonarqube.targets
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}

// SonarQube Prometheus endpoint, authenticated with the system passcode.
prometheus.scrape "sonarqube" {
  targets         = [{"__address__" = "sonarqube:9000", "service_name" = "sonarqube"}]
  job_name        = "sonarqube"
  metrics_path    = "/api/monitoring/metrics"
  scrape_interval = "60s"
  authorization {
    type        = "Bearer"
    credentials = sys.env("SONAR_MONITORING_PASSCODE")
  }
  forward_to = [prometheus.remote_write.lgtm.receiver]
}

// Host metrics (node_exporter equivalent) from the read-only host mounts.
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.lgtm.receiver]
}

prometheus.remote_write "lgtm" {
  endpoint {
    url = sys.env("MIMIR_URL")
  }
  external_labels = {"project" = "sonarr"}
}
