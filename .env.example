# Copy to .env and adjust.
SONAR_HOST=sonarqube.org
# SonarQube Developer image tag (without -developer suffix)
SONARQUBE_VERSION=2026.5.5
# Company ACME server (RFC 8555 + External Account Binding)
ACME_CA_SERVER=https://acme.company.example/acme/directory
ACME_EMAIL=admin@company.example
ACME_EAB_KID=your-eab-key-id
ACME_EAB_HMAC=your-base64url-eab-hmac-key
ACME_KEY_TYPE=EC256
# Company root CA bundle if the ACME endpoint is not publicly trusted (file in ./certs)
#ACME_CA_CERTIFICATES=/certs/company-root-ca.pem
# Set empty (TLS_CERTRESOLVER=) to skip ACME and use Traefik's self-signed cert.
TLS_CERTRESOLVER=company
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=sonarqube
POSTGRES_USER=sonarqube
POSTGRES_PASSWORD=change-me
SONAR_MONITORING_PASSCODE=change-me-too

BACKUP_DIR=./backups
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# LGTM endpoints (defaults point at Loki/Mimir published on the docker host)
LOKI_URL=http://host.docker.internal:3100/loki/api/v1/push
MIMIR_URL=http://host.docker.internal:9009/api/v1/push
